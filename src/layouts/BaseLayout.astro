---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getContent } from '../content/site';
import { getLocaleFromUrl } from '../i18n';
import { hreflangAlternates, OG_IMAGE, organizationJsonLd } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogType = 'website', ogImage = OG_IMAGE, jsonLd } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const content = getContent(locale);
const pageTitle = title ?? content.meta.title;
const pageDescription = description ?? content.meta.description;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalPath = pathname === '/' ? '/' : `${pathname}/`;
const canonical = new URL(canonicalPath, Astro.site).href;
const alternates = hreflangAlternates(Astro.url.pathname);
const jsonLdBlocks = [
  organizationJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={alternates.ru} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_GB'} />
    <meta property="og:site_name" content="ZOOEMBRIO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-light.png" sizes="96x96" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-dark.png" sizes="96x96" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} content={content} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} content={content} />
    <CookieBanner locale={locale} />
    <script src="/scripts/cart.js" defer></script>
    <script src="/scripts/form-ajax.js" defer></script>
  </body>
</html>
