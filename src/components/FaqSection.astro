---
import type { FaqItem } from '../data/seo';
import SpotDots from './SpotDots.astro';

interface Props {
  title: string;
  items: FaqItem[];
}

const { title, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="border-t border-brand-navy/5 bg-white py-16 md:py-20" id="faq">
      <div class="section-container mx-auto max-w-3xl">
        <SpotDots class="mb-4" />
        <h2 class="section-title">{title}</h2>
        <div class="mt-8 space-y-3">
          {items.map((item) => (
            <details class="group rounded-2xl border border-brand-navy/10 bg-brand-cream/40 px-5 py-4 open:bg-brand-cream/70">
              <summary class="cursor-pointer list-none font-display text-base font-bold text-brand-navy marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-start justify-between gap-3">
                  <span>{item.question}</span>
                  <span class="shrink-0 text-spot-coral transition group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-brand-navy/75">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
