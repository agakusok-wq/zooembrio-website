---
import type { SiteContent } from '../content/site';
import SpotDots from './SpotDots.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="py-20">
  <div class="section-container">
    <SpotDots class="mb-4 justify-center" />
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">{content.partners.title}</h2>
      <p class="mt-4 text-brand-navy/70">{content.partners.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {
        content.partners.items.map((partner) => (
          <article class="flex flex-col overflow-hidden rounded-3xl border-2 border-brand-navy/8 bg-white shadow-card">
            {partner.image ? (
              <img
                src={partner.image}
                alt={partner.imageAlt}
                class="h-44 w-full object-cover"
                loading="lazy"
                width="640"
                height="360"
              />
            ) : null}
            <div class="flex flex-1 flex-col p-6">
              {partner.metric ? (
                <span class="mb-3 inline-flex w-fit rounded-full bg-spot-teal/15 px-3 py-1 text-xs font-bold text-brand-navy">
                  {partner.metric}
                </span>
              ) : null}
              <h3 class="font-display text-lg font-bold text-brand-navy">{partner.name}</h3>
              <p class="mt-1 text-xs font-bold uppercase tracking-wide text-spot-coral">{partner.role}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-navy/75">{partner.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
