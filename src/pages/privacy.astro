---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { privacyTitle, privacySections } from '../data/privacy';
---

<BaseLayout>
  <PageBanner title={privacyTitle} subtitle="Порядок обработки персональных данных на сайте zooembrio.ru" palette="contact" />
  <article class="section-container max-w-3xl py-12 leading-relaxed text-brand-navy/90">
    {
      privacySections.map((section) => (
        <section class="mt-10 first:mt-0">
          {section.heading && (
            <h2 class="mb-4 font-display text-xl font-bold text-brand-navy">{section.heading}</h2>
          )}
          <div class="space-y-3 text-sm md:text-base">
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      ))
    }
  </article>
</BaseLayout>
