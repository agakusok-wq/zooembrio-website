---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { formatNewsDate, getNewsSorted } from '../../data/news';
import { getLocaleFromUrl, localizedPath } from '../../i18n';

const locale = getLocaleFromUrl(Astro.url);
const articles = getNewsSorted();
const title = locale === 'ru' ? 'Новости ZOOEMBRIO' : 'ZOOEMBRIO News';
const subtitle =
  locale === 'ru'
    ? 'Запуски направлений, протоколы лабораторий и материалы по средам АРТ для лошадей и КРС.'
    : 'Product launches, lab protocols and notes on ART media for horses and cattle.';
const description =
  locale === 'ru'
    ? 'Новости ZOOEMBRIO: среды АРТ для лошадей и КРС, витрификация, OPU, производство в России. Актуальные материалы для эмбриологов и племенных хозяйств.'
    : 'ZOOEMBRIO news: ART media for horses and cattle, vitrification, OPU, manufacturing in Russia — updates for embryologists and breeding programmes.';
---

<BaseLayout title={`${title} | среды АРТ для лошадей и КРС`} description={description}>
  <PageBanner title={locale === 'ru' ? 'Новости' : 'News'} subtitle={subtitle} palette="contact" />
  <section class="py-16">
    <div class="section-container mx-auto max-w-3xl space-y-6">
      {
        articles.map((article) => {
          const loc = article.locales[locale];
          return (
            <article class="rounded-3xl border-2 border-brand-navy/10 bg-white p-6 shadow-card transition hover:border-spot-coral/30">
              <time class="text-xs font-bold uppercase tracking-wide text-brand-navy/45" datetime={article.date}>
                {formatNewsDate(article.date, locale)}
              </time>
              <h2 class="mt-2 font-display text-xl font-extrabold text-brand-navy">
                <a href={localizedPath(`/news/${article.slug}`, locale)} class="hover:text-spot-coral">
                  {loc.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-brand-navy/75">{loc.excerpt}</p>
              <a
                href={localizedPath(`/news/${article.slug}`, locale)}
                class="mt-4 inline-block text-sm font-bold text-spot-coral"
              >
                {locale === 'ru' ? 'Читать полностью →' : 'Read more →'}
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
