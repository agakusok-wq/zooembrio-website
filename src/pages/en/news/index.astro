---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import { formatNewsDate, getNewsSorted } from '../../../data/news';
import { localizedPath } from '../../../i18n';

const locale = 'en' as const;
const articles = getNewsSorted();
const description =
  'ZOOEMBRIO news: ART media for horses and cattle, vitrification, OPU, manufacturing in Russia — updates for embryologists and breeding programmes.';
---

<BaseLayout title="ZOOEMBRIO News | equine and bovine ART media" description={description}>
  <PageBanner
    title="News"
    subtitle="Product launches, lab protocols and notes on ART media for horses and cattle."
    palette="contact"
  />
  <section class="py-16">
    <div class="section-container mx-auto max-w-3xl space-y-6">
      {
        articles.map((article) => {
          const loc = article.locales.en;
          return (
            <article class="rounded-3xl border-2 border-brand-navy/10 bg-white p-6 shadow-card transition hover:border-spot-coral/30">
              <time class="text-xs font-bold uppercase tracking-wide text-brand-navy/45" datetime={article.date}>
                {formatNewsDate(article.date, locale)}
              </time>
              <h2 class="mt-2 font-display text-xl font-extrabold text-brand-navy">
                <a href={localizedPath(`/news/${article.slug}`, locale)} class="hover:text-spot-coral">
                  {loc.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-brand-navy/75">{loc.excerpt}</p>
              <a
                href={localizedPath(`/news/${article.slug}`, locale)}
                class="mt-4 inline-block text-sm font-bold text-spot-coral"
              >
                Read more →
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
