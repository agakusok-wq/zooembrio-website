---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import TechnologyAdvantages from '../../components/TechnologyAdvantages.astro';
import TechnologyDetail from '../../components/TechnologyDetail.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getContent } from '../../content/site';
import { breadcrumbJsonLd, faqJsonLd, getPageSeo } from '../../data/seo';

const content = getContent('en');
const seo = getPageSeo('technology', 'en');
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'ZOOEMBRIO', path: '/en/' },
    { name: content.technology.title, path: '/en/technology/' },
  ]),
  ...(seo.faqs ? [faqJsonLd(seo.faqs)] : []),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <PageBanner title={content.technology.title} subtitle={content.technology.subtitle} palette="technology" />
  <TechnologyAdvantages content={content} />
  <TechnologyDetail content={content} />
  {seo.faqs && <FaqSection title="Technology FAQ" items={seo.faqs} />}
</BaseLayout>
